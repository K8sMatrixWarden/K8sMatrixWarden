   },
   "spec": {
    "tls": [
     {
      "hosts": [
       "secure.dvka.example"
      ],
      "secretName": "tls"
     }
    ],
    "rules": [
     {
      "host": "secure.dvka.example",
      "http": {
       "paths": [
        {
         "path": "/",
         "pathType": "Prefix",
         "backend": {
          "service": {
           "name": "neg-clusterip",
           "port": {
            "number": 8080
           }
          }
         }
        }
       ]
      }
     }
    ]
   }
  }
